# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://autoscar:${POSTGRES_PASSWORD}@postgres:5432/autoscar

# Redis
REDIS_URL=redis://redis:6379

# Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-apikey

# OpenAI
OPENAI_API_KEY=sk-...

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=http://minio:9000

# WhatsApp Sellers Group
SELLERS_GROUP_JID=          # Format: XXXX@g.us

# Auth
JWT_SECRET=change-me-jwt-secret-min-32-chars

# Instagram (optional)
INSTAGRAM_ACCESS_TOKEN=     # Meta Graph API access token
INSTAGRAM_PAGE_ID=          # Instagram page/account ID
INSTAGRAM_VERIFY_TOKEN=autoscar-ig-verify

# SMS / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # E.164 format: +5511999999999

# WhatsApp Cloud API (optional - alternative to Evolution API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=autoscar-verify-token  # Token for Meta webhook verification

# Frontend
FRONTEND_URL=http://localhost:3000

# App
APP_PORT=3001
NODE_ENV=production
