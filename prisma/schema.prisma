generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Performance: add ?connection_limit=10&pool_timeout=30 to DATABASE_URL

model WhatsAppInstance {
  id                  String   @id @default(cuid())
  name                String   @unique
  provider            String   @default("evolution") // "evolution" | "cloud_api"
  evolutionInstanceId String?  // Required for Evolution API
  phoneNumberId       String?  // Meta Phone Number ID (Cloud API)
  businessAccountId   String?  // Meta Business Account ID (Cloud API)
  accessToken         String?  // Meta Access Token (Cloud API)
  phoneNumber         String?
  status              String   @default("disconnected")
  tenantId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vehicle {
  id        String   @id @default(cuid())
  portalUrl String   @unique
  model     String
  year      String
  price     String
  mileage   String
  photos    String[]
  cachedAt  DateTime @default(now())
  tenantId  String?
}

model Pipeline {
  id                 String               @id @default(cuid())
  name               String
  stages             Stage[]
  leads              Lead[]
  qualificationRules QualificationRule[]
  tenantId           String?
  createdAt          DateTime             @default(now())
}

model QualificationRule {
  id           String   @id @default(cuid())
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  field        String
  operator     String
  value        String
  stageTrigger String
  tenantId     String?
  createdAt    DateTime @default(now())
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  order      Int
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  leads      Lead[]
  tenantId   String?
}

model Lead {
  id            String        @id @default(cuid())
  phone         String
  contactPhone  String?
  name          String?
  email         String?
  city          String?
  creditStatus  String?
  paymentMethod String?
  vehicleUrl    String?
  stageId       String?
  stage         Stage?        @relation(fields: [stageId], references: [id])
  pipelineId    String?
  pipeline      Pipeline?     @relation(fields: [pipelineId], references: [id])
  humanOverride    Boolean       @default(false)
  followupAttempts Int           @default(0)
  lastFollowupAt   DateTime?
  reengagementAttempts Int       @default(0)
  lastReengagementAt   DateTime?
  sellerNotifiedAt     DateTime?
  conversation     Conversation?
  notes            LeadNote[]
  tenantId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([phone, pipelineId, vehicleUrl])
  @@index([stageId])
  @@index([pipelineId])
  @@index([createdAt])
  @@index([updatedAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  content   String
  type      String   @default("ai")
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  leadId    String    @unique
  lead      Lead      @relation(fields: [leadId], references: [id])
  channel   String    @default("whatsapp")
  messages  Message[]
  tenantId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
  @@index([channel])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String
  content        String
  media          String[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([role, createdAt])
}

model Agent {
  id                String   @id @default(cuid())
  name              String
  description       String?
  model             String   @default("gpt-4o")
  systemPrompt      String   @db.Text
  welcomeMessage    String?  @db.Text
  qualificationFields String[] @default(["interest", "creditStatus", "city", "paymentMethod"])
  channels          String[] @default(["whatsapp", "instagram", "sms"])
  instances         String[] @default([])
  maxFollowups      Int      @default(2)
  followupDelayHours Int     @default(24)
  portalUrl         String   @default("https://www.autoscar.com.br")
  triggerVehicleUrls String[]  @default([])
  triggerVehicleCodes String[] @default([])
  sellersGroupJid   String?
  sellersPhone      String?
  webchatEnabled    Boolean  @default(true)
  webchatTitle      String?
  webchatSubtitle   String?
  webchatBrandColor String?
  webchatAvatarUrl  String?
  webchatWelcome    String?  @db.Text
  active            Boolean  @default(true)
  temperature       Float    @default(0.7)
  tenantId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("operator")
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  tenantId  String?
  createdAt DateTime @default(now())
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  events    String[]
  secret    String
  active    Boolean  @default(true)
  tenantId  String?
  createdAt DateTime @default(now())
}

model FollowupConfig {
  id                      String   @id @default("singleton")
  enabled                 Boolean  @default(true)
  maxAttempts             Int      @default(3)
  minHoursBetween         Int      @default(20)
  scanHour                Int      @default(9)
  scanMinute              Int      @default(0)
  skipWeekends            Boolean  @default(false)
  skipIfLeadResponded     Boolean  @default(true)
  useAgentPrompt          Boolean  @default(true)
  customPromptTemplate    String?  @db.Text
  exhaustedStageName      String   @default("Desqualificado")
  tenantId                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
